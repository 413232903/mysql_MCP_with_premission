# 服务器配置 / Server Configuration
HOST=127.0.0.1
PORT=3000

# MySQL 数据库配置 / MySQL Database Configuration
MYSQL_HOST=localhost
MYSQL_PORT=3306
MYSQL_USER=root
MYSQL_PASSWORD=your_password
MYSQL_DATABASE=your_database

# MySQL 连接超时配置 / MySQL Connection Timeout
DB_CONNECTION_TIMEOUT=5

# MySQL 8.0 认证插件 / MySQL 8.0 Auth Plugin
# 可选值 / Options: mysql_native_password, caching_sha2_password
# 使用 caching_sha2_password 需要安装 cryptography 包
DB_AUTH_PLUGIN=mysql_native_password

# 数据库连接池配置 / Database Connection Pool Configuration
DB_POOL_ENABLED=true
DB_POOL_MIN_SIZE=5
DB_POOL_MAX_SIZE=20
DB_POOL_RECYCLE=300
DB_POOL_MAX_LIFETIME=0
DB_POOL_ACQUIRE_TIMEOUT=10.0

# 环境类型 / Environment Type
# 可选值 / Options: development, production
ENV_TYPE=development

# SQL 安全配置 / SQL Security Configuration
# 允许的风险等级（逗号分隔）/ Allowed risk levels (comma-separated)
# 可选值 / Options: LOW, MEDIUM, HIGH, CRITICAL
ALLOWED_RISK_LEVELS=LOW,MEDIUM

# 允许查询敏感字段 / Allow sensitive info queries
ALLOW_SENSITIVE_INFO=false

# 自定义敏感字段模式（逗号分隔）/ Custom sensitive fields (comma-separated)
SENSITIVE_INFO_FIELDS=

# 最大 SQL 语句长度 / Max SQL length
MAX_SQL_LENGTH=5000

# 阻止的 SQL 模式（逗号分隔）/ Blocked SQL patterns (comma-separated)
BLOCKED_PATTERNS=

# 启用查询安全检查 / Enable query check
ENABLE_QUERY_CHECK=true

# 数据库隔离配置 / Database Isolation Configuration
# 启用数据库隔离 / Enable database isolation
ENABLE_DATABASE_ISOLATION=false

# 数据库访问级别 / Database access level
# 可选值 / Options: strict, restricted, permissive
# strict: 仅允许访问指定数据库 / Only specified database
# restricted: 允许指定数据库 + 系统库 / Specified database + system databases
# permissive: 允许所有数据库 / All databases (default)
DATABASE_ACCESS_LEVEL=permissive

# 日志级别 / Log Level
# 可选值 / Options: DEBUG, INFO, WARNING, ERROR, CRITICAL
LOG_LEVEL=DEBUG

# ========================================
# 角色权限控制配置 / Role Permission Configuration
# ========================================

# 启用角色权限控制 / Enable role permission control
ENABLE_ROLE_PERMISSION=false

# 需要应用权限过滤的表列表（逗号分隔）/ Tables requiring permission filtering (comma-separated)
# 示例 / Example: orders,products,customers
PERMISSION_TABLES=

# 权限字段名称 / Permission field name
# 默认为 gssq 字段 / Default is gssq field
PERMISSION_FIELD=gssq

# 用户角色表配置 / User Role Table Configuration
USER_ROLE_TABLE=fr_user_role
USER_ROLE_USERNAME_FIELD=username
USER_ROLE_EXTEND_FIELD=extend1
USER_ROLE_PREFIX=RX

# 超级管理员用户列表（逗号分隔，这些用户不受权限控制）/ Super admin users (comma-separated, bypassing permission control)
# 示例 / Example: admin,system,root
SUPER_ADMIN_USERS=
