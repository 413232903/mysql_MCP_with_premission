# 服务器配置
HOST=127.0.0.1            # 服务器监听地址
PORT=3000                 # 服务器监听端口

# 数据库连接配置
MYSQL_HOST=localhost      # MySQL服务器地址
MYSQL_PORT=3306           # MySQL服务器端口
MYSQL_USER=root           # MySQL用户名
MYSQL_PASSWORD=           # MySQL密码（留空表示无密码）
MYSQL_DATABASE=testdb     # 要连接的数据库名
DB_CONNECTION_TIMEOUT=5   # 连接超时时间（秒）

# MySQL 8.0 认证插件配置
# - mysql_native_password: 兼容性好，不需要额外依赖，但安全性较低
# - caching_sha2_password: MySQL 8.0 默认，安全性高，需要 cryptography 包
# 如果使用 MySQL 8.0 且用户采用 caching_sha2_password，请确保已安装 cryptography 包
DB_AUTH_PLUGIN=mysql_native_password  # 认证插件类型

# 数据库连接池配置
DB_POOL_ENABLED=true      # 是否启用连接池 (true/false)
DB_POOL_MIN_SIZE=5        # 连接池最小连接数
DB_POOL_MAX_SIZE=20       # 连接池最大连接数
DB_POOL_RECYCLE=300       # 连接回收时间（秒）
DB_POOL_MAX_LIFETIME=0    # 连接最大存活时间（秒，0表示不限制）
DB_POOL_ACQUIRE_TIMEOUT=10.0  # 获取连接超时时间（秒）

# 环境类型
# development: 开发环境，较少限制
# production: 生产环境，严格安全限制
ENV_TYPE=development

# 安全配置
# 允许的风险等级: LOW(查询), MEDIUM(安全修改), HIGH(结构变更), CRITICAL(危险操作)
ALLOWED_RISK_LEVELS=LOW,MEDIUM,HIGH

# 是否允许查询敏感字段信息(密码，凭证等)
ALLOW_SENSITIVE_INFO=false

# 最大SQL语句长度限制
MAX_SQL_LENGTH=5000

# 阻止的SQL模式，多个模式用逗号分隔
# 例如: 'DROP TABLE,DROP DATABASE,DELETE FROM' 将阻止包含这些字符串的查询
BLOCKED_PATTERNS=

# 是否启用查询安全检查
ENABLE_QUERY_CHECK=true

# 数据库隔离配置
# 是否启用数据库隔离（防止跨数据库访问）
ENABLE_DATABASE_ISOLATION=false
# 数据库访问级别: strict(严格), restricted(限制), permissive(宽松)
# - strict: 只能访问指定的数据库
# - restricted: 可以访问指定数据库和系统库(information_schema, mysql等)
# - permissive: 可以访问所有数据库（默认）
# 注意：生产环境(ENV_TYPE=production)会自动启用数据库隔离并设为restricted模式
DATABASE_ACCESS_LEVEL=permissive

# 日志配置
# DEBUG, INFO, WARNING, ERROR, CRITICAL
LOG_LEVEL=DEBUG

# 角色权限控制配置（行级权限）
# 是否启用角色权限控制
ENABLE_ROLE_PERMISSION=true

# 需要应用权限过滤的表列表（逗号分隔，不区分大小写）
# 例如: PERMISSION_TABLES=orders,products,customers,invoices
PERMISSION_TABLES=

# 权限字段名称（默认 gssq）
# 该字段存储用户的权限标识，用于行级权限过滤
PERMISSION_FIELD=gssq

# 用户角色表配置
# 存储用户角色信息的表名
USER_ROLE_TABLE=fr_user_role
# 用户角色表中的用户名字段
USER_ROLE_USERNAME_FIELD=username
# 用户角色表中存储权限标识的字段（通常包含角色前缀）
USER_ROLE_EXTEND_FIELD=extend1
# 权限标识的前缀（会在查询时自动去除）
USER_ROLE_PREFIX=RX

# 超级管理员用户列表（逗号分隔）
# 这些用户将跳过权限检查，可以查询所有数据
# 例如: SUPER_ADMIN_USERS=admin,system,root
SUPER_ADMIN_USERS=

# ========================================
# MCP服务鉴权配置（安全整改：HTTP Header 鉴权，禁止明文参数校验）
# ========================================

# 鉴权总开关（生产环境必须为 true，否则服务器拒绝启动）
ENABLE_AUTH=true

# 鉴权模式: token(Bearer静态令牌) | hmac(动态签名) | both(默认)
AUTH_MODE=both

# 执行模式: off(放行,仅本地调试) | audit(只记日志,灰度观察) | enforce(拦截,默认)
AUTH_ENFORCE_MODE=enforce

# 凭据存储后端: env(环境变量) | db(数据库表,建表见 docs/sql/auth_tables.sql)
AUTH_TOKEN_BACKEND=env

# Token 配置: client_id:token_sha256_hex[:user_id][:expires_at][:scopes]，多组分号分隔
# 生成: python scripts/gen_token.py token --client-id bailian-prod --user-id report_user
# 安全: 只存 SHA-256 哈希，明文仅签发时显示一次，严禁入库/入git
AUTH_TOKENS=

# HMAC 密钥配置: app_key:app_secret[:client_id][:user_id][:scopes]，多组分号分隔
# 生成: python scripts/gen_token.py hmac-key --client-id bi-system
AUTH_HMAC_KEYS=

# db 后端凭据表名
AUTH_TOKEN_TABLE=mcp_auth_token
AUTH_HMAC_KEY_TABLE=mcp_auth_key

# 签名时间戳允许偏差（秒）
AUTH_TIMESTAMP_TOLERANCE=300

# Nonce 防重放窗口（秒，应 >= 2倍时间戳偏差）
AUTH_NONCE_TTL=600

# 豁免鉴权的路径（逗号分隔，仅限探活端点）
AUTH_EXEMPT_PATHS=/health

# 行级权限身份绑定: 凭据绑定的 user_id 优先于工具入参（防止伪造user_id越权）
AUTH_BIND_USER=true

# 防爆破: 同IP连续失败阈值 / 封禁时长（秒）
AUTH_MAX_FAILURES=10
AUTH_BLOCK_SECONDS=600

# db 后端凭据缓存TTL（秒），吊销操作最迟此时长后生效
AUTH_CREDENTIAL_CACHE_TTL=60

# 服务器调试模式（生产环境强制关闭）
SERVER_DEBUG=false 